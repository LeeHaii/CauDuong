<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/IfcOperations/IfcOperationsDashboard.uss?fileID=7433441132597879392&amp;guid=f7c178696f66d0a48a3bfbbea2a920fc&amp;type=3#IfcOperationsDashboard"/>
    <ui:VisualElement name="dashboard-root" picking-mode="Ignore" class="dashboard-root">
        <ui:VisualElement name="home-page" class="module-page home-page hud-interactive">
            <ui:VisualElement class="module-topbar">
                <ui:VisualElement class="brand-block">
                    <ui:Label text="DT" class="brand-mark"/>
                    <ui:VisualElement class="brand-copy">
                        <ui:Label text="DIGITALTWIN3D.VN" class="brand-title"/>
                        <ui:Label text="HỆ THỐNG QUẢN LÝ BIM &amp; HẠ TẦNG CẤU KIỆN" class="brand-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="home-menu-actions">
                    <ui:DropdownField name="home-project-dropdown" value="Tất Cả Dự Án" class="home-project-dropdown"/>
                    <ui:Button name="home-login-button" text="Đăng nhập" class="home-login-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="home-content">
                <ui:VisualElement class="home-heading-row">
                    <ui:VisualElement class="home-hero-copy">
                        <ui:Label text="HỆ THỐNG QUẢN LÝ BIM &amp; VẬN HÀNH HẠ TẦNG CẤU KIỆN" class="home-title"/>
                        <ui:Label text="Tích hợp toàn diện cơ sở dữ liệu tệp IFC, nhật ký thu thập hiện trường di động và mô hình 3D không gian." class="home-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="home-summary-strip">
                        <ui:VisualElement class="home-summary-item">
                            <ui:Label name="home-model-count" text="0" class="home-summary-value"/>
                            <ui:Label text="Mô hình IFC" class="home-summary-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="home-summary-item">
                            <ui:Label name="home-inspection-count" text="0" class="home-summary-value home-summary-warning"/>
                            <ui:Label text="Ghi nhận hiện trường" class="home-summary-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="home-summary-item home-summary-last">
                            <ui:Label name="home-element-count" text="0" class="home-summary-value home-summary-green"/>
                            <ui:Label text="Cấu kiện đang nạp" class="home-summary-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="module-nav-grid">
                    <ui:Button name="home-data-button" class="module-nav-card module-nav-data" style="height: 227px;">
                        <ui:Label text="▤" class="module-card-index module-card-icon" style="padding-right: 1px;"/>
                        <ui:Label text="Quản lý Cơ sở dữ liệu" class="module-card-title"/>
                        <ui:Label text="Quản lý CSDL các tập tệp mô hình IFC, dự án, đơn vị thi công và chỉnh sửa thông tin dữ liệu." class="module-card-copy"/>
                        <ui:Label text="Truy cập CSDL IFC  →" class="module-card-command" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    </ui:Button>
                    <ui:Button name="home-report-button" class="module-nav-card module-nav-report" style="height: 227px;">
                        <ui:Label text="3D" class="module-card-index module-card-icon"/>
                        <ui:Label text="Quản lý Báo cáo Vận hành BIM Kết cấu" class="module-card-title"/>
                        <ui:Label text="Xem mô hình 3D, quản lý trạng thái cấu kiện và báo cáo vận hành kết cấu công trình." class="module-card-copy" style="height: 47px; margin-top: 2px;"/>
                        <ui:Label text="Mở Giao diện 3D  →" class="module-card-command" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    </ui:Button>
                    <ui:Button name="home-field-button" class="module-nav-card module-nav-field" style="height: 227px;">
                        <ui:Label text="▣" class="module-card-index module-card-icon" style="-unity-text-align: middle-center; white-space: normal; padding-right: 1px;"/>
                        <ui:Label text="Báo cáo Hiện trường" class="module-card-title"/>
                        <ui:Label text="Thu thập ảnh và GPS tại hiện trường, lưu dữ liệu kiểm tra và đồng bộ lên hệ thống." class="module-card-copy"/>
                        <ui:Label text="Mở Báo cáo Hiện trường  →" class="module-card-command" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    </ui:Button>
                    <ui:Button name="home-dashboard-button" class="module-nav-card module-nav-dashboard" style="height: 227px;">
                        <ui:Label text="▥" class="module-card-index module-card-icon" style="padding-right: 1px;"/>
                        <ui:Label text="Dashboard Vận Hành" class="module-card-title"/>
                        <ui:Label text="Báo cáo tổng hợp trạng thái vận hành và bảo trì toàn bộ cấu kiện dự án theo thời gian thực." class="module-card-copy"/>
                        <ui:Label text="Xem Dashboard  →" class="module-card-command" style="border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="data-page" class="module-page workspace-page hud-interactive" style="display: none;">
            <ui:VisualElement class="module-topbar workspace-topbar">
                <ui:Button name="data-home-button" text="‹  Trang Tổng" class="module-back-button"/>
                <ui:VisualElement class="module-header-copy">
                    <ui:Label text="Quản Lý Dữ Liệu" class="workspace-title"/>
                    <ui:Label text="Danh mục mô hình IFC dùng cho báo cáo hạ tầng" class="workspace-subtitle"/>
                </ui:VisualElement>
                <ui:Button name="open-model-upload-button" text="+  Thêm Mô Hình IFC" class="workspace-primary-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="workspace-content">
                <ui:VisualElement class="data-summary-row">
                    <ui:Label name="registry-count" text="0 mô hình trong kho dữ liệu" class="data-summary-title"/>
                    <ui:Label text="Các mô hình đang bật sẽ tự động nạp vào không gian báo cáo." class="data-summary-note"/>
                </ui:VisualElement>
                <ui:VisualElement class="data-filter-row">
                    <ui:TextField name="filter-project-input" label="Dự án" class="module-field data-filter"/>
                    <ui:TextField name="filter-province-input" label="Tỉnh / Thành phố" class="module-field data-filter"/>
                    <ui:TextField name="filter-ward-input" label="Xã / Phường" class="module-field data-filter"/>
                    <ui:TextField name="filter-file-input" label="Tên file IFC" class="module-field data-filter data-filter-last"/>
                </ui:VisualElement>
                <ui:VisualElement class="data-table-shell">
                    <ui:VisualElement class="data-table-header">
                        <ui:Label text="Tên Tệp IFC" class="data-cell data-cell-file"/>
                        <ui:Label text="Dự Án" class="data-cell data-cell-project"/>
                        <ui:Label text="Địa Điểm" class="data-cell data-cell-location"/>
                        <ui:Label text="Đơn Vị Thi Công" class="data-cell data-cell-unit"/>
                        <ui:Label text="Ngày Tải" class="data-cell data-cell-date"/>
                        <ui:Label text="Dung Lượng" class="data-cell data-cell-size"/>
                        <ui:Label text="Trạng Thái" class="data-cell data-cell-state"/>
                        <ui:Label text="Thao Tác" class="data-cell data-cell-action"/>
                    </ui:VisualElement>
                    <ui:ScrollView name="registry-scroll" mode="Vertical" class="data-table-scroll">
                        <ui:VisualElement name="registry-list" class="data-table-body"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="model-upload-overlay" class="modal-overlay module-modal-overlay">
                <ui:VisualElement class="model-upload-dialog modal-surface">
                    <ui:VisualElement class="module-modal-heading">
                        <ui:VisualElement>
                            <ui:Label name="model-upload-title" text="Thêm Mô Hình IFC" class="modal-title"/>
                            <ui:Label text="Bổ sung nguồn dữ liệu mới vào hệ thống." class="module-modal-subtitle"/>
                        </ui:VisualElement>
                        <ui:Button name="close-model-upload-button" text="×" class="icon-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="module-form-grid">
                        <ui:DropdownField name="model-project-input" label="Dự án *" class="module-field module-field-half"/>
                        <ui:DropdownField name="model-province-input" label="Tỉnh / Thành phố *" class="module-field module-field-half module-field-right"/>
                        <ui:TextField name="model-ward-input" label="Xã / Phường" class="module-field module-field-half"/>
                        <ui:TextField name="model-unit-input" label="Đơn vị quản lý" class="module-field module-field-half module-field-right"/>
                    </ui:VisualElement>
                    <ui:Label text="File mô hình IFC *" class="modal-field-label"/>
                    <ui:VisualElement class="file-picker-row">
                        <ui:Label name="selected-ifc-path" text="Chưa chọn file .ifc" class="selected-file-label"/>
                        <ui:Button name="choose-ifc-file-button" text="Chọn IFC" class="modal-button modal-button-secondary"/>
                    </ui:VisualElement>
                    <ui:Label name="model-upload-error" text="" class="modal-error"/>
                    <ui:VisualElement class="modal-actions">
                        <ui:Button name="cancel-model-upload-button" text="Hủy" class="modal-button modal-button-secondary"/>
                        <ui:Button name="save-model-upload-button" text="Thêm &amp; Nạp Mô Hình" class="modal-button modal-button-primary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="field-page" class="module-page workspace-page hud-interactive" style="display: none;">
            <ui:VisualElement class="module-topbar workspace-topbar">
                <ui:Button name="field-home-button" text="‹  Trang Tổng" class="module-back-button"/>
                <ui:VisualElement class="module-header-copy">
                    <ui:Label text="Quản Lý Hiện Trường" class="workspace-title"/>
                    <ui:Label text="Ghi nhận hư hỏng và đồng bộ vị trí về báo cáo ArcGIS" class="workspace-subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement class="workspace-header-actions">
                    <ui:Label name="field-record-count" text="0 ghi nhận" class="workspace-count-badge"/>
                    <ui:Button name="open-inspection-form-button" text="+  Tạo Ghi Nhận" class="workspace-primary-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="workspace-content field-workspace-content">
                <ui:VisualElement class="field-history-panel">
                    <ui:VisualElement class="field-panel-heading-row">
                        <ui:Label text="Bảng Ghi Nhận Hiện Trường" class="field-panel-title"/>
                        <ui:Label text="Danh sách ghi nhận đã đồng bộ từ hiện trường" class="field-panel-meta"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="field-table-header">
                        <ui:Label text="STT" class="field-table-cell field-table-index"/>
                        <ui:Label text="Tình trạng" class="field-table-cell field-table-status"/>
                        <ui:Label text="Tên sự cố / kiểm tra" class="field-table-cell field-table-name"/>
                        <ui:Label text="Dự án" class="field-table-cell field-table-project"/>
                        <ui:Label text="Cấu kiện IFC" class="field-table-cell field-table-element"/>
                        <ui:Label text="Thời gian" class="field-table-cell field-table-time"/>
                        <ui:Label text="Tọa độ" class="field-table-cell field-table-coordinate"/>
                        <ui:Label text="Thao tác" class="field-table-cell field-table-actions"/>
                    </ui:VisualElement>
                    <ui:ScrollView name="field-history-scroll" mode="Vertical" class="field-history-scroll">
                        <ui:VisualElement name="field-history-list" class="field-history-list"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inspection-form-overlay" class="modal-overlay module-modal-overlay">
                <ui:VisualElement class="inspection-form-dialog modal-surface">
                    <ui:VisualElement class="module-modal-heading">
                        <ui:VisualElement>
                            <ui:Label name="inspection-form-title" text="Tạo Ghi Nhận Hiện Trường" class="modal-title"/>
                            <ui:Label text="Ảnh, tình trạng và tọa độ sẽ được đồng bộ với cấu kiện IFC và ArcGIS." class="module-modal-subtitle"/>
                        </ui:VisualElement>
                        <ui:Button name="close-inspection-form-button" text="×" class="icon-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="inspection-dialog-body">
                        <ui:VisualElement class="field-photo-panel">
                            <ui:VisualElement class="field-panel-heading-row">
                                <ui:Label text="Ảnh Hiện Trường" class="field-panel-title"/>
                                <ui:Label text="PNG / JPG" class="field-panel-meta"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="inspection-image-preview" class="inspection-image-preview">
                                <ui:VisualElement name="inspection-image-placeholder" class="inspection-image-placeholder">
                                    <ui:Label text="ẢNH" class="image-placeholder-mark"/>
                                    <ui:Label text="Chưa có ảnh hiện trường" class="image-placeholder-title"/>
                                    <ui:Label text="Chọn ảnh thể hiện rõ vị trí hư hỏng." class="image-placeholder-copy"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button name="choose-inspection-image-button" text="Chọn Ảnh Hiện Trường" class="field-secondary-button"/>
                            <ui:Label name="inspection-image-path" text="Chưa chọn ảnh" class="field-file-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="field-form-panel">
                            <ui:VisualElement class="field-panel-heading-row">
                                <ui:Label text="Thông Tin Kiểm Tra" class="field-panel-title"/>
                                <ui:Button name="use-selected-element-button" text="Dùng cấu kiện đang chọn" class="field-inline-button"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-select-row">
                                <ui:DropdownField name="inspection-project-dropdown" label="Dự án" class="module-field inspection-select-field inspection-project-field"/>
                            </ui:VisualElement>
                            <ui:TextField name="inspection-name-input" label="Tên sự cố / nội dung kiểm tra *" class="module-field"/>
                            <ui:VisualElement class="inspection-processing-row">
                                <ui:DropdownField name="inspection-status-dropdown" label="Tình trạng xử lý" class="module-field inspection-processing-field"/>
                                <ui:Label text="Tự động chuyển thành Đã xử lý sau khi xuất báo cáo vận hành." class="inspection-processing-hint"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-select-row inspection-meta-row">
                                <ui:TextField name="inspection-element-type-input" label="Loại cấu kiện" class="module-field inspection-select-field"/>
                                <ui:TextField name="inspection-created-by-input" label="Người tạo" class="module-field inspection-select-field inspection-select-field-last"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="coordinate-row">
                                <ui:TextField name="inspection-latitude-input" label="Vĩ độ" class="module-field coordinate-field"/>
                                <ui:TextField name="inspection-longitude-input" label="Kinh độ" class="module-field coordinate-field coordinate-field-middle"/>
                                <ui:TextField name="inspection-elevation-input" label="Cao độ (m)" class="module-field coordinate-field"/>
                            </ui:VisualElement>
                            <ui:TextField name="inspection-note-input" label="Mô tả / ghi chú hiện trường" multiline="true" class="module-field field-note-input"/>
                            <ui:Label name="inspection-form-error" text="" class="modal-error"/>
                            <ui:VisualElement class="modal-actions inspection-form-actions">
                                <ui:Button name="cancel-inspection-form-button" text="Hủy" class="modal-button modal-button-secondary"/>
                                <ui:Button name="submit-inspection-button" text="Lưu Ghi Nhận" class="modal-button modal-button-primary"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="report-page" picking-mode="Ignore" class="report-page" style="display: none;">
            <ui:VisualElement name="top-toolbar" class="top-toolbar hud-interactive">
                <ui:VisualElement class="brand-block">
                    <ui:Label text="P" class="brand-mark"/>
                    <ui:VisualElement class="brand-copy">
                        <ui:Label text="BIM-GIS InfraOps" class="brand-title"/>
                        <ui:Label text="Quản Lý Vận Hành Hạ Tầng Giao Thông" class="brand-subtitle"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="toolbar-actions">
                    <ui:DropdownField name="map-source" value="ArcGIS World Street" class="map-dropdown toolbar-secondary" style="padding-left: 0; padding-right: 0; margin-left: 8px;"/>
                    <ui:Button name="frame-model-button" text="Mô Hình Tuyến Vành Đai 3" class="toolbar-button toolbar-button-primary"/>
                    <ui:Button name="report-home-button" text="Trang Tổng" class="toolbar-button"/>
                    <ui:Button name="layer-button" text="Lớp IFC (0)" class="toolbar-button toolbar-button-primary"/>
                    <ui:Button name="inspection-button" text="Hiện Trường (0)" class="toolbar-button toolbar-secondary"/>
                    <ui:Button name="measure-button" text="Đo Đạc 3D" class="toolbar-button toolbar-secondary"/>
                    <ui:Button name="export-button" text="Export &amp; Báo Cáo" class="toolbar-button toolbar-button-export"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="left-panel" class="side-panel left-panel hud-interactive">
                <ui:VisualElement class="panel-heading-row">
                    <ui:Label text="Cấu Trúc Hạ Tầng (IFC)" class="panel-heading"/>
                    <ui:Label name="total-count" text="0 cấu kiện" class="count-badge"/>
                </ui:VisualElement>
                <ui:Label text="LỌC THEO TRẠNG THÁI VẬN HÀNH" class="section-kicker"/>
                <ui:VisualElement class="filter-grid">
                    <ui:Button name="filter-all" text="Tất cả  0" class="filter-button filter-button-active"/>
                    <ui:Button name="filter-operational" text="Tốt  0" class="filter-button filter-operational"/>
                    <ui:Button name="filter-warning" text="Bảo trì  0" class="filter-button filter-warning"/>
                    <ui:Button name="filter-critical" text="Hỏng hóc  0" class="filter-button filter-critical"/>
                    <ui:Button name="filter-repairing" text="Đang sửa  0" class="filter-button filter-repairing"/>
                </ui:VisualElement>
                <ui:Label text="DANH SÁCH LỚP CẤU KIỆN IFC" class="section-kicker section-kicker-spaced"/>
                <ui:ScrollView name="category-scroll" mode="Vertical" mouse-wheel-scroll-size="4" class="category-scroll">
                    <ui:VisualElement name="category-list" class="category-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="details-panel" class="side-panel details-panel hud-interactive">
                <ui:VisualElement class="panel-heading-row">
                    <ui:Label text="Chi Tiết Cấu Kiện &amp; Vận Hành" class="panel-heading"/>
                    <ui:Button name="close-details-button" text="×" tooltip="Đóng bảng chi tiết" class="icon-button close-button"/>
                </ui:VisualElement>
                <ui:ScrollView name="details-scroll" mode="Vertical" mouse-wheel-scroll-size="4" class="details-scroll">
                    <ui:VisualElement class="identity-card">
                        <ui:VisualElement class="identity-top-row">
                            <ui:Label name="detail-ifc-type" text="IfcProduct" class="ifc-type-badge"/>
                            <ui:VisualElement name="color-swatch" tooltip="Màu RGBA nguyên bản" class="color-swatch"/>
                        </ui:VisualElement>
                        <ui:Label name="detail-name" text="Chưa chọn cấu kiện" class="detail-name"/>
                        <ui:Label name="detail-global-id" text="GlobalID: -" class="identity-line"/>
                        <ui:Label name="detail-express-id" text="ExpressID: -" class="identity-line identity-link"/>
                    </ui:VisualElement>
                    <ui:Label text="Tên Cấu Kiện Hiển Thị" class="field-label"/>
                    <ui:TextField name="display-name-input" class="dashboard-input"/>
                    <ui:Label text="Ghi Chú Vận Hành / Bảo Trì" class="field-label"/>
                    <ui:TextField name="maintenance-note-input" multiline="true" class="dashboard-input note-input"/>
                    <ui:Label text="Trạng Thái Vận Hành Tức Thời" class="field-label"/>
                    <ui:DropdownField name="status-dropdown" class="dashboard-input status-dropdown"/>
                    <ui:Button name="save-operations-button" text="Lưu Thay Đổi &amp; Cập Nhật Mô Hình 3D" class="save-button"/>
                    <ui:VisualElement class="property-heading-row">
                        <ui:Label name="property-set-count" text="PropertySets (1)" class="property-heading"/>
                        <ui:Button name="add-custom-property-button" text="+ Thêm Thuộc Tính" class="add-property-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="property-list" class="property-list"/>
                    <ui:VisualElement name="element-inspection-history" class="element-inspection-history">
                        <ui:VisualElement class="element-inspection-heading-row">
                            <ui:VisualElement>
                                <ui:Label text="Lịch Sử Kiểm Tra Kỹ Thuật" class="element-inspection-title"/>
                                <ui:Label text="Các sự cố và lần kiểm tra gắn trực tiếp với cấu kiện" class="element-inspection-subtitle"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="element-inspection-summary">
                            <ui:VisualElement class="element-inspection-kpi">
                                <ui:Label name="element-inspection-total" text="0" class="element-inspection-kpi-value"/>
                                <ui:Label text="Tổng ghi nhận" class="element-inspection-kpi-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="element-inspection-kpi">
                                <ui:Label name="element-inspection-open" text="0" class="element-inspection-kpi-value inspection-open-color"/>
                                <ui:Label text="Chưa xử lý" class="element-inspection-kpi-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="element-inspection-kpi element-inspection-kpi-last">
                                <ui:Label name="element-inspection-resolved" text="0" class="element-inspection-kpi-value inspection-resolved-color"/>
                                <ui:Label text="Đã xử lý" class="element-inspection-kpi-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="element-inspection-list" class="element-inspection-list"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="model-manager-popup" class="toolbar-popup model-manager-popup hud-interactive">
                <ui:VisualElement class="popup-heading-row">
                    <ui:Label text="DANH SÁCH FILE IFC ĐANG MỞ" class="popup-heading"/>
                    <ui:Button name="clear-models-button" text="Xóa tất cả" class="popup-danger-link"/>
                </ui:VisualElement>
                <ui:VisualElement name="model-list" class="model-list"/>
            </ui:VisualElement>
            <ui:VisualElement name="measurement-popup" class="toolbar-popup measurement-popup hud-interactive">
                <ui:Label text="CÔNG CỤ ĐO ĐẠC HẠ TẦNG" class="popup-heading"/>
                <ui:Button name="measure-distance-button" text="Đo Khoảng Cách                 Distance" class="popup-command"/>
                <ui:Button name="measure-height-button" text="Đo Chiều Cao                       Height" class="popup-command"/>
                <ui:Button name="measure-area-button" text="Đo Diện Tích                            Area" class="popup-command"/>
                <ui:VisualElement class="popup-divider"/>
                <ui:Button name="clear-measurements-button" text="Xóa Tất Cả Phép Đo" class="popup-command popup-danger-command"/>
            </ui:VisualElement>
            <ui:VisualElement name="export-popup" class="toolbar-popup export-popup hud-interactive">
                <ui:Button name="export-csv-button" text="Export File Excel (.CSV)" class="popup-command"/>
                <ui:Button name="export-json-button" text="Export Dữ Liệu BIM (.JSON)" class="popup-command"/>
                <ui:Button name="export-pdf-button" text="Dashboard Báo Cáo Vận Hành" class="popup-command"/>
            </ui:VisualElement>
            <ui:VisualElement name="inspection-popup" class="toolbar-popup inspection-popup hud-interactive">
                <ui:VisualElement class="popup-heading-row">
                    <ui:Label text="ĐIỂM KIỂM TRA HIỆN TRƯỜNG" class="popup-heading"/>
                    <ui:Button name="open-field-from-report-button" text="+ Thêm" class="popup-danger-link inspection-add-link"/>
                </ui:VisualElement>
                <ui:ScrollView name="inspection-popup-scroll" mode="Vertical" class="inspection-popup-scroll">
                    <ui:VisualElement name="inspection-popup-list" class="inspection-popup-list"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="custom-property-overlay" class="modal-overlay hud-interactive">
                <ui:VisualElement class="custom-property-dialog modal-surface">
                    <ui:Label name="custom-property-title" text="+ Thêm Thuộc Tính IFC" class="modal-title"/>
                    <ui:Label text="Tên Thuộc Tính (Key)" class="modal-field-label"/>
                    <ui:TextField name="custom-property-key" class="modal-input"/>
                    <ui:Label text="Giá Trị Thuộc Tính (Value)" class="modal-field-label"/>
                    <ui:TextField name="custom-property-value" multiline="true" class="modal-input"/>
                    <ui:Label name="custom-property-error" text="" class="modal-error"/>
                    <ui:VisualElement class="modal-actions">
                        <ui:Button name="cancel-custom-property-button" text="Hủy" class="modal-button modal-button-secondary"/>
                        <ui:Button name="save-custom-property-button" text="Thêm" class="modal-button modal-button-primary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="inspection-detail-overlay" class="modal-overlay hud-interactive">
                <ui:VisualElement class="inspection-detail-dialog modal-surface">
                    <ui:VisualElement class="inspection-detail-heading">
                        <ui:VisualElement>
                            <ui:Label text="Chi Tiết Kiểm Tra Kỹ Thuật" class="modal-title"/>
                            <ui:Label name="inspection-detail-created-at" text="-" class="module-modal-subtitle"/>
                        </ui:VisualElement>
                        <ui:Button name="close-inspection-detail-button" text="×" tooltip="Đóng chi tiết kiểm tra" class="icon-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="inspection-detail-body">
                        <ui:VisualElement class="inspection-detail-photo-panel">
                            <ui:VisualElement name="inspection-detail-image" class="inspection-detail-image">
                                <ui:VisualElement name="inspection-detail-image-placeholder" class="inspection-detail-image-placeholder">
                                    <ui:Label text="ẢNH" class="image-placeholder-mark"/>
                                    <ui:Label text="Ghi nhận chưa có ảnh" class="image-placeholder-title"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:ScrollView mode="Vertical" class="inspection-detail-properties">
                            <ui:Label name="inspection-detail-status" text="Chưa xử lý" class="inspection-detail-status"/>
                            <ui:Label name="inspection-detail-name" text="-" class="inspection-detail-name"/>
                            <ui:VisualElement class="inspection-detail-property">
                                <ui:Label text="Loại cấu kiện" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-type" text="-" class="inspection-detail-property-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-property">
                                <ui:Label text="Dự án" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-project" text="-" class="inspection-detail-property-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-property">
                                <ui:Label text="Cấu kiện IFC" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-element" text="-" class="inspection-detail-property-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-property">
                                <ui:Label text="Tọa độ" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-coordinate" text="-" class="inspection-detail-property-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-property inspection-detail-note-property">
                                <ui:Label text="Mô tả / ghi chú" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-note" text="-" class="inspection-detail-property-value inspection-detail-note"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-property">
                                <ui:Label text="Người tạo" class="inspection-detail-property-label"/>
                                <ui:Label name="inspection-detail-creator" text="-" class="inspection-detail-property-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="inspection-detail-actions">
                                <ui:Button name="inspection-detail-map-button" text="Xem trên bản đồ 3D" class="inspection-detail-action inspection-detail-map-action"/>
                                <ui:Button name="inspection-detail-edit-button" text="Sửa" class="inspection-detail-action"/>
                                <ui:Button name="inspection-detail-delete-button" text="Xóa" class="inspection-detail-action inspection-detail-delete-action"/>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="analytics-overlay" class="analytics-overlay hud-interactive">
                <ui:VisualElement class="analytics-shell">
                    <ui:VisualElement class="analytics-header">
                        <ui:VisualElement>
                            <ui:Label text="Báo Cáo Vận Hành &amp; Bảo Trì" class="analytics-title"/>
                            <ui:Label name="analytics-generated-at" text="Dữ liệu tổng hợp hiện tại" class="analytics-subtitle"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="analytics-header-actions">
                            <ui:Button name="analytics-export-pdf-button" text="Xuất Báo Cáo PDF" class="analytics-export-button"/>
                            <ui:Button name="close-analytics-button" text="×" tooltip="Đóng dashboard báo cáo" class="analytics-close-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView mode="Vertical" class="analytics-scroll">
                        <ui:VisualElement class="analytics-kpi-row">
                            <ui:VisualElement class="analytics-kpi analytics-kpi-total">
                                <ui:Label text="TỔNG CẤU KIỆN" class="analytics-kpi-label"/>
                                <ui:Label name="analytics-total-count" text="0" class="analytics-kpi-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="analytics-kpi analytics-kpi-operational">
                                <ui:Label text="HOẠT ĐỘNG TỐT" class="analytics-kpi-label"/>
                                <ui:Label name="analytics-operational-count" text="0" class="analytics-kpi-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="analytics-kpi analytics-kpi-warning">
                                <ui:Label text="CẦN BẢO TRÌ" class="analytics-kpi-label"/>
                                <ui:Label name="analytics-warning-count" text="0" class="analytics-kpi-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="analytics-kpi analytics-kpi-critical">
                                <ui:Label text="HỎNG HÓC" class="analytics-kpi-label"/>
                                <ui:Label name="analytics-critical-count" text="0" class="analytics-kpi-value"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="analytics-kpi analytics-kpi-repairing">
                                <ui:Label text="ĐANG SỬA CHỮA" class="analytics-kpi-label"/>
                                <ui:Label name="analytics-repairing-count" text="0" class="analytics-kpi-value"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="analytics-main-row">
                            <ui:VisualElement class="analytics-panel analytics-status-panel">
                                <ui:Label text="Phân Bố Trạng Thái Vận Hành" class="analytics-panel-title"/>
                                <ui:VisualElement class="analytics-donut-layout">
                                    <ui:VisualElement name="analytics-status-chart" class="analytics-donut-chart"/>
                                    <ui:VisualElement name="analytics-status-legend" class="analytics-legend"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="analytics-panel analytics-category-panel">
                                <ui:Label text="Trạng Thái Theo Nhóm Hạ Tầng" class="analytics-panel-title"/>
                                <ui:VisualElement name="analytics-category-chart" class="analytics-column-chart"/>
                                <ui:VisualElement name="analytics-category-legend" class="analytics-inline-legend"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="analytics-panel analytics-source-panel">
                            <ui:VisualElement class="analytics-panel-heading-row">
                                <ui:Label text="Phân Bố Cấu Kiện Theo File IFC" class="analytics-panel-title"/>
                                <ui:Label name="analytics-model-count" text="0 mô hình" class="analytics-model-count"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="analytics-source-chart" class="analytics-source-chart"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="analytics-panel analytics-recent-panel">
                            <ui:VisualElement class="analytics-panel-heading-row">
                                <ui:Label text="Báo Cáo Hiện Trường Gần Đây" class="analytics-panel-title"/>
                                <ui:Label text="Ghi nhận mới nhất" class="analytics-recent-meta"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="analytics-recent-inspections" class="analytics-recent-inspections"/>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="status-strip" class="status-strip hud-interactive">
                <ui:Label name="import-status" text="Sẵn sàng." class="status-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="measurement-hud" class="measurement-hud hud-interactive">
                <ui:Label name="measurement-hud-title" text="ĐO ĐẠC 3D" class="measurement-hud-title"/>
                <ui:Label name="measurement-hud-value" text="Chọn điểm trên mô hình IFC." class="measurement-hud-value"/>
            </ui:VisualElement>
            <ui:VisualElement name="loading-overlay" class="loading-overlay hud-interactive">
                <ui:VisualElement class="loading-surface">
                    <ui:Label text="BIM-GIS INFRAOPS" class="loading-brand"/>
                    <ui:Label text="QUẢN LÝ BÁO CÁO HẠ TẦNG" class="loading-title"/>
                    <ui:VisualElement name="loading-spinner" class="loading-spinner"/>
                    <ui:Label name="loading-message" text="Đang chuẩn bị dữ liệu hệ thống..." class="loading-message"/>
                    <ui:VisualElement class="loading-progress-track">
                        <ui:VisualElement name="loading-progress-fill" class="loading-progress-fill"/>
                    </ui:VisualElement>
                    <ui:Label name="loading-detail" text="Vui lòng chờ đến khi dữ liệu sẵn sàng" class="loading-detail"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
