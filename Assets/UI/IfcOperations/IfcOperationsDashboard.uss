:root {
    --surface: #f8fafc;
    --surface-strong: #ffffff;
    --ink: #172033;
    --muted: #62708a;
    --border: #cdd7e5;
    --blue: #2167e8;
    --blue-dark: #174fb8;
    --cyan: #078cbd;
    --green: #0b9b6d;
    --purple: #8b32d8;
    --danger: #d9364d;
    --warning: #d39a24;
}

.dashboard-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    color: var(--ink);
    font-size: 13px;
}

.dashboard-root .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
}

.dashboard-root .unity-scroller--vertical .unity-scroller__low-button,
.dashboard-root .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.dashboard-root .unity-scroller--vertical .unity-base-slider {
    width: 6px;
    min-width: 6px;
    margin-left: 0;
    margin-right: 0;
}

.dashboard-root .unity-scroller--vertical .unity-base-slider__tracker {
    width: 4px;
    margin-left: 1px;
    border-width: 0;
    border-radius: 2px;
    background-color: #e2e8f1;
}

.dashboard-root .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    min-width: 4px;
    margin-left: 1px;
    border-width: 0;
    border-radius: 2px;
    background-color: #8e9bb0;
}

.dashboard-root .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: #66758d;
}

.top-toolbar {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 12px;
    background-color: rgba(255, 255, 255, 0.97);
    border-width: 1px;
    border-color: rgba(207, 218, 232, 0.95);
    border-radius: 8px;
}

.brand-block,
.toolbar-actions,
.panel-heading-row,
.identity-top-row,
.property-heading-row,
.category-header {
    flex-direction: row;
    align-items: center;
}

.brand-block {
    min-width: 300px;
    height: 38px;
}

.brand-mark {
    width: 38px;
    height: 38px;
    margin-right: 10px;
    border-radius: 6px;
    background-color: #5b6df6;
    color: #ffffff;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.brand-copy {
    height: 38px;
    justify-content: center;
}

.brand-title {
    height: 20px;
    font-size: 16px;
    -unity-font-style: bold;
}

.brand-subtitle {
    height: 16px;
    color: #394760;
    font-size: 11px;
    -unity-font-style: bold;
}

.toolbar-actions {
    flex-grow: 1;
    justify-content: flex-end;
}

.toolbar-button,
.map-dropdown {
    height: 38px;
    min-width: 132px;
    margin-left: 8px;
    padding-left: 13px;
    padding-right: 13px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    background-color: #f7f9fc;
    color: var(--ink);
    font-size: 12px;
    -unity-font-style: bold;
}

.toolbar-button:hover {
    background-color: #edf2f9;
    border-color: #9db2ce;
}

.toolbar-button:active {
    scale: 0.98 0.98;
}

.toolbar-button-primary {
    background-color: var(--blue);
    border-color: var(--blue);
    color: #ffffff;
}

.toolbar-button-primary:hover {
    background-color: var(--blue-dark);
    border-color: var(--blue-dark);
}

.toolbar-button-export {
    background-color: var(--purple);
    border-color: var(--purple);
    color: #ffffff;
}

.map-dropdown {
    min-width: 175px;
}

.map-dropdown .unity-base-popup-field__input {
    border-width: 1px;
    border-color: var(--border);
    border-radius: 5px;
    background-color: #f7f9fc;
}

.side-panel {
    position: absolute;
    top: 82px;
    bottom: 34px;
    background-color: rgba(250, 252, 255, 0.97);
    border-width: 1px;
    border-color: rgba(198, 211, 227, 0.96);
    border-radius: 8px;
    overflow: hidden;
}

.left-panel {
    left: 12px;
    width: 340px;
    padding: 14px;
}

.details-panel {
    right: 12px;
    width: 380px;
    padding: 14px 0 0 14px;
}

.panel-heading-row {
    min-height: 30px;
    justify-content: space-between;
}

.panel-heading {
    font-size: 15px;
    -unity-font-style: bold;
}

.count-badge,
.ifc-type-badge,
.pset-badge {
    padding: 4px 8px;
    border-radius: 5px;
    background-color: #e0f3ff;
    color: var(--cyan);
    font-size: 11px;
    -unity-font-style: bold;
}

.section-kicker {
    margin-top: 9px;
    margin-bottom: 5px;
    color: #263247;
    font-size: 11px;
    -unity-font-style: bold;
}

.section-kicker-spaced {
    margin-top: 12px;
}

.filter-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.filter-button {
    width: 48%;
    height: 30px;
    margin-right: 2%;
    margin-bottom: 5px;
    border-width: 0;
    border-radius: 5px;
    background-color: #e8edf5;
    color: #1d293c;
    font-size: 11px;
    -unity-font-style: bold;
}

.filter-button:hover {
    background-color: #dce4ef;
}

.filter-button-active {
    background-color: var(--blue);
    color: #ffffff;
}

.filter-operational.filter-button-active {
    background-color: var(--green);
}

.filter-warning.filter-button-active {
    background-color: var(--warning);
}

.filter-critical.filter-button-active {
    background-color: var(--danger);
}

.filter-repairing.filter-button-active {
    background-color: #3479c9;
}

.category-scroll,
.details-scroll {
    flex-grow: 1;
}

.category-list {
    width: 100%;
    padding-right: 4px;
    padding-bottom: 10px;
}

.category-card {
    margin-bottom: 8px;
    padding: 9px;
    background-color: var(--surface-strong);
    border-width: 1px;
    border-color: #d9e1ec;
    border-radius: 6px;
}

.category-header {
    min-height: 29px;
}

.category-toggle {
    width: 18px;
    margin-right: 4px;
}

.category-toggle .unity-toggle__label {
    display: none;
}

.category-symbol {
    width: 27px;
    height: 24px;
    margin-right: 7px;
    border-radius: 4px;
    color: #ffffff;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.category-title {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    font-size: 12px;
    -unity-font-style: bold;
}

.category-count {
    min-width: 35px;
    flex-shrink: 0;
    color: var(--muted);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.asset-row {
    height: 25px;
    margin-top: 1px;
    padding-left: 33px;
    padding-right: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #26354d;
    font-size: 11px;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    overflow: hidden;
}

.asset-row:hover,
.asset-row-selected {
    background-color: #eaf2ff;
    color: var(--blue-dark);
}

.category-expand {
    height: 29px;
    margin-top: 5px;
    margin-left: 22px;
    border-width: 1px;
    border-color: #77a7f5;
    border-radius: 5px;
    background-color: #f3f7ff;
    color: var(--blue);
    font-size: 10px;
    -unity-font-style: italic;
}

.category-empty {
    margin: 5px 0 3px 33px;
    color: #8793a7;
    font-size: 10px;
    -unity-font-style: italic;
}

.icon-button {
    width: 28px;
    height: 28px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #162033;
    font-size: 21px;
    -unity-font-style: bold;
}

.icon-button:hover {
    background-color: #e8edf5;
}

.close-button {
    margin-right: 12px;
}

.details-scroll {
    margin-top: 8px;
    padding-right: 14px;
    padding-bottom: 12px;
}

.identity-card {
    padding: 10px;
    background-color: #f4f7fb;
    border-width: 1px;
    border-color: #d8e1ec;
    border-radius: 6px;
}

.identity-top-row {
    justify-content: space-between;
}

.color-swatch {
    width: 34px;
    height: 20px;
    border-width: 1px;
    border-color: #aeb9c9;
    border-radius: 4px;
}

.detail-name {
    margin-top: 7px;
    margin-bottom: 5px;
    white-space: normal;
    font-size: 14px;
    -unity-font-style: bold;
}

.identity-line {
    font-size: 11px;
    -unity-font-style: bold;
}

.identity-link {
    color: var(--blue);
}

.field-label {
    margin-top: 10px;
    margin-bottom: 4px;
    font-size: 11px;
    -unity-font-style: bold;
}

.dashboard-input {
    min-height: 34px;
    margin: 0;
}

.dashboard-input .unity-base-field__label {
    display: none;
}

.dashboard-input .unity-base-text-field__input,
.dashboard-input .unity-base-popup-field__input {
    border-width: 1px;
    border-color: #cbd6e5;
    border-radius: 5px;
    background-color: #ffffff;
    color: var(--ink);
}

.note-input {
    height: 68px;
}

.save-button {
    height: 40px;
    margin-top: 12px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--green);
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.save-button:hover {
    background-color: #087d59;
}

.property-heading-row {
    margin-top: 15px;
    padding-bottom: 7px;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: #d8e0eb;
}

.property-heading {
    font-size: 13px;
    -unity-font-style: bold;
}

.add-property-button {
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 0;
    border-radius: 5px;
    background-color: #e1f2ff;
    color: var(--cyan);
    font-size: 11px;
    -unity-font-style: bold;
}

.add-property-button:hover {
    background-color: #cceaff;
}

.property-list {
    padding-bottom: 10px;
}

.property-row {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #e2e7ef;
}

.property-copy {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.property-key {
    margin-bottom: 3px;
    color: #202c40;
    font-size: 10px;
    -unity-font-style: bold;
}

.property-value {
    white-space: normal;
    color: #43516a;
    font-size: 11px;
}

.property-actions {
    width: 54px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
}

.property-action-button {
    width: 25px;
    height: 25px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #f06a3b;
    font-size: 14px;
    -unity-font-style: bold;
}

.property-action-delete {
    color: #a090ab;
}

.property-action-button:hover {
    background-color: #edf2f8;
}

.property-set-heading {
    margin-top: 9px;
    padding-top: 4px;
    padding-bottom: 4px;
    color: var(--cyan);
    font-size: 11px;
    -unity-font-style: bold;
}

.modal-overlay,
.analytics-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 13, 24, 0.78);
}

.modal-surface {
    width: 380px;
    padding: 20px;
    border-width: 1px;
    border-color: #33445f;
    border-radius: 8px;
    background-color: #111a2d;
}

.modal-title {
    margin-bottom: 12px;
    color: #39bdf8;
    font-size: 17px;
    -unity-font-style: bold;
}

.modal-field-label {
    margin-top: 7px;
    margin-bottom: 5px;
    color: #a8b4c8;
    font-size: 11px;
}

.modal-input {
    min-height: 34px;
    margin: 0;
}

.modal-input .unity-base-field__label {
    display: none;
}

.modal-input .unity-base-text-field__input {
    min-height: 34px;
    border-width: 1px;
    border-color: #394961;
    border-radius: 5px;
    background-color: #202b3d;
    color: #f5f8fc;
}

.modal-error {
    min-height: 18px;
    margin-top: 5px;
    color: #ff7b8d;
    font-size: 10px;
    white-space: normal;
}

.modal-actions {
    margin-top: 10px;
    flex-direction: row;
    justify-content: flex-end;
}

.modal-button {
    height: 32px;
    min-width: 58px;
    margin-left: 8px;
    border-width: 0;
    border-radius: 5px;
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
}

.modal-button-secondary {
    background-color: #303b50;
}

.modal-button-primary {
    background-color: #078cce;
}

.analytics-overlay {
    align-items: stretch;
    justify-content: stretch;
    background-color: rgba(8, 14, 24, 0.9);
}

.analytics-shell {
    position: absolute;
    top: 28px;
    right: 36px;
    bottom: 28px;
    left: 36px;
    padding: 18px;
    border-width: 1px;
    border-color: #c9d4e3;
    border-radius: 8px;
    background-color: #f6f8fb;
}

.analytics-header,
.analytics-header-actions,
.analytics-kpi-row,
.analytics-main-row,
.analytics-donut-layout,
.analytics-panel-heading-row,
.analytics-inline-legend,
.analytics-source-row {
    flex-direction: row;
    align-items: center;
}

.analytics-header {
    min-height: 48px;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: #d7dee9;
}

.analytics-title {
    color: #172033;
    font-size: 20px;
    -unity-font-style: bold;
}

.analytics-subtitle {
    margin-top: 3px;
    color: #6b7890;
    font-size: 10px;
}

.analytics-export-button {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--purple);
    color: #ffffff;
    font-size: 11px;
    -unity-font-style: bold;
}

.analytics-close-button {
    width: 34px;
    height: 34px;
    margin-left: 8px;
    padding: 0;
    border-width: 0;
    background-color: #e7ebf2;
    color: #202b3d;
    font-size: 20px;
    -unity-font-style: bold;
}

.analytics-scroll {
    flex-grow: 1;
    padding-top: 12px;
}

.analytics-kpi-row {
    justify-content: space-between;
    margin-bottom: 12px;
}

.analytics-kpi {
    width: 19%;
    min-height: 72px;
    padding: 11px;
    border-left-width: 4px;
    border-radius: 5px;
    background-color: #ffffff;
}

.analytics-kpi-total { border-left-color: #46566f; }
.analytics-kpi-operational { border-left-color: #18ad73; }
.analytics-kpi-warning { border-left-color: #e5a11a; }
.analytics-kpi-critical { border-left-color: #d52a43; }
.analytics-kpi-repairing { border-left-color: #226edc; }

.analytics-kpi-label {
    color: #6c7890;
    font-size: 9px;
    -unity-font-style: bold;
}

.analytics-kpi-value {
    margin-top: 6px;
    color: #172033;
    font-size: 24px;
    -unity-font-style: bold;
}

.analytics-main-row {
    align-items: stretch;
    margin-bottom: 12px;
}

.analytics-panel {
    padding: 13px;
    border-width: 1px;
    border-color: #d8e0eb;
    border-radius: 6px;
    background-color: #ffffff;
}

.analytics-status-panel {
    width: 34%;
    margin-right: 12px;
}

.analytics-category-panel {
    flex-grow: 1;
}

.analytics-panel-title {
    color: #243047;
    font-size: 12px;
    -unity-font-style: bold;
}

.analytics-donut-layout {
    min-height: 220px;
    justify-content: center;
}

.analytics-donut-chart {
    width: 190px;
    height: 190px;
    flex-shrink: 0;
}

.analytics-legend {
    min-width: 125px;
    margin-left: 12px;
}

.analytics-legend-row,
.analytics-inline-legend-item {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.analytics-legend-swatch {
    width: 10px;
    height: 10px;
    margin-right: 7px;
    border-radius: 3px;
}

.analytics-legend-label {
    min-width: 0;
    flex-grow: 1;
    color: #4a5870;
    font-size: 9px;
    white-space: normal;
}

.analytics-legend-value {
    margin-left: 6px;
    color: #202b3d;
    font-size: 10px;
    -unity-font-style: bold;
}

.analytics-column-chart {
    min-height: 226px;
    margin-top: 8px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-around;
    border-bottom-width: 1px;
    border-bottom-color: #aeb9c8;
}

.analytics-column-group {
    width: 15%;
    height: 218px;
    align-items: stretch;
    justify-content: flex-end;
}

.analytics-column-bars {
    height: 154px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.analytics-column-bar {
    width: 18%;
    min-height: 3px;
    margin-left: 1px;
    margin-right: 1px;
    border-radius: 2px 2px 0 0;
}

.analytics-column-label {
    height: 58px;
    min-height: 58px;
    margin-top: 5px;
    color: #5f6c81;
    font-size: 8px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.analytics-inline-legend {
    min-height: 28px;
    justify-content: center;
}

.analytics-inline-legend-item {
    margin-left: 9px;
    margin-right: 9px;
}

.analytics-source-panel {
    min-height: 130px;
}

.analytics-panel-heading-row {
    justify-content: space-between;
}

.analytics-model-count {
    padding: 3px 7px;
    border-radius: 4px;
    background-color: #e3edff;
    color: var(--blue);
    font-size: 9px;
    -unity-font-style: bold;
}

.analytics-source-chart {
    margin-top: 8px;
}

.analytics-source-row {
    min-height: 34px;
}

.analytics-source-name {
    width: 230px;
    flex-shrink: 0;
    color: #3d4a60;
    font-size: 9px;
    text-overflow: ellipsis;
    overflow: hidden;
}

.analytics-source-track {
    height: 12px;
    flex-grow: 1;
    background-color: #e7ecf3;
    border-radius: 4px;
    overflow: hidden;
}

.analytics-source-fill {
    height: 12px;
    background-color: #2784d8;
}

.analytics-source-value {
    width: 70px;
    margin-left: 8px;
    color: #263247;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.status-strip {
    position: absolute;
    left: 365px;
    right: 405px;
    bottom: 8px;
    min-height: 24px;
    padding: 4px 10px;
    background-color: rgba(25, 34, 51, 0.86);
    border-radius: 5px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.status-text {
    color: #ffffff;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.status-strip-visible {
    opacity: 1;
}

.measurement-hud {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 320px;
    margin-left: -160px;
    padding: 10px 14px;
    border-radius: 6px;
    background-color: rgba(16, 24, 40, 0.94);
    border-width: 1px;
    border-color: rgba(56, 189, 248, 0.7);
    display: none;
    align-items: center;
}

.measurement-hud-title {
    color: rgb(56, 189, 248);
    font-size: 11px;
    -unity-font-style: bold;
}

.measurement-hud-value {
    margin-top: 3px;
    color: rgb(248, 250, 252);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.toolbar-popup {
    position: absolute;
    top: 76px;
    display: none;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.99);
    border-width: 1px;
    border-color: #cbd6e5;
    border-radius: 7px;
}

.model-manager-popup {
    right: 350px;
    width: 335px;
}

.measurement-popup {
    right: 175px;
    width: 255px;
}

.export-popup {
    right: 12px;
    width: 255px;
}

.popup-heading-row {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.popup-heading {
    color: #202b3d;
    font-size: 11px;
    -unity-font-style: bold;
}

.popup-danger-link {
    height: 26px;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #e03b4f;
    font-size: 11px;
}

.model-list {
    margin-top: 4px;
}

.model-row {
    height: 40px;
    margin-top: 5px;
    padding: 0 7px;
    flex-direction: row;
    align-items: center;
    background-color: #f5f7fb;
    border-width: 1px;
    border-color: #d8e1ec;
    border-radius: 5px;
}

.model-visibility {
    width: 22px;
    margin-right: 5px;
}

.model-visibility .unity-toggle__label {
    display: none;
}

.model-name {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #202b3d;
    font-size: 11px;
    -unity-font-style: bold;
    text-overflow: ellipsis;
    overflow: hidden;
}

.model-remove {
    width: 28px;
    height: 28px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #bd4253;
    font-size: 18px;
}

.popup-command {
    height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #202b3d;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.popup-command:hover {
    background-color: #edf3fb;
}

.popup-command-active {
    background-color: #e2edff;
    color: var(--blue);
}

.popup-divider {
    height: 1px;
    margin: 5px 4px;
    background-color: #dce3ed;
}

.popup-danger-command {
    color: #dd3d50;
}

.loading-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 17, 29, 0.91);
}

.loading-spinner {
    width: 48px;
    height: 48px;
    margin-bottom: 18px;
    border-width: 4px;
    border-color: #20445c;
    border-top-color: #24c3ff;
    border-radius: 24px;
}

.loading-message {
    max-width: 680px;
    color: #27c4ff;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.dashboard-compact .brand-block {
    min-width: 230px;
}

.dashboard-compact .brand-subtitle {
    display: none;
}

.dashboard-compact .toolbar-button,
.dashboard-compact .map-dropdown {
    min-width: 105px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
}

.dashboard-compact .toolbar-secondary {
    display: none;
}

.dashboard-narrow .brand-copy {
    display: none;
}

.dashboard-narrow .brand-block {
    min-width: 42px;
}

.dashboard-narrow .left-panel {
    width: 300px;
}

.dashboard-narrow .details-panel {
    width: 340px;
}

.dashboard-narrow .status-strip {
    left: 325px;
    right: 365px;
}

.dashboard-compact .analytics-shell {
    right: 18px;
    left: 18px;
}

.dashboard-compact .analytics-donut-chart {
    width: 150px;
    height: 150px;
}

.dashboard-narrow .analytics-main-row {
    flex-direction: column;
}

.dashboard-narrow .analytics-status-panel {
    width: auto;
    margin-right: 0;
    margin-bottom: 10px;
}
