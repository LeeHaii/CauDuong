}

.image-placeholder-title {
    margin-top: 12px;
    color: #4c5c73;
    font-size: 11px;
    -unity-font-style: bold;
}

.image-placeholder-copy,
.field-file-name {
    margin-top: 4px;
    color: #8190a4;
    font-size: 9px;
}

.field-secondary-button,
.field-inline-button {
    height: 34px;
    border-width: 1px;
    border-color: #b9c9dc;
    border-radius: 5px;
    background-color: #f5f8fc;
