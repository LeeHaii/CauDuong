    font-size: 11px;
    -unity-font-style: bold;
}

.field-workspace-content {
    flex-direction: column;
}

.field-main-row {
    height: 54%;
    min-height: 330px;
    align-items: stretch;
}

.field-photo-panel,
.field-form-panel,
.field-history-panel {
    padding: 18px;
    border-width: 1px;
    border-color: #d1dbe8;
    border-radius: 7px;
    background-color: #ffffff;
}

.field-photo-panel {
    width: 40%;
    margin-right: 14px;
}

.field-form-panel {
    flex-grow: 1;
}

.field-panel-heading-row {
    min-height: 28px;
    justify-content: space-between;
}

.field-panel-title {
    color: #1d293c;
    font-size: 13px;
    -unity-font-style: bold;
}

.field-panel-meta {
    color: #7a879b;
    font-size: 9px;
}

.inspection-image-preview {
    flex-grow: 1;
    min-height: 190px;
    margin-top: 10px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #cbd6e4;
    border-radius: 6px;
    background-color: #eef3f8;
    -unity-background-scale-mode: scale-and-crop;
}

.inspection-image-placeholder {
    align-items: center;
}

.image-placeholder-mark {
    width: 46px;
    height: 34px;
    border-width: 1px;
    border-color: #9eacc0;
    border-radius: 5px;
    color: #77869b;
    font-size: 9px;
    -unity-font-style: bold;
