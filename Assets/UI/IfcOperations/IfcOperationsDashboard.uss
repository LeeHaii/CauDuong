    font-size: 10px;
    -unity-font-style: bold;
}

.field-inline-button {
    height: 28px;
}

.field-form-panel .module-field {
    margin-top: 10px;
}

.coordinate-row {
    align-items: flex-end;
}

.coordinate-field {
